# Core runtime
MODE=paper
LOG_LEVEL=INFO

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=algo
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5433/algo

# Redis
REDIS_URL=redis://localhost:6379/0

# Market data sources
# Options: ibkr, alphavantage, yfinance
MARKET_DATA_SOURCE=alphavantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Broker configuration
BROKER_SIMULATED=true
SIMULATED_EQUITY=100000
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = paper, 7496 = live
IBKR_CLIENT_ID=101

# GitHub deployment helpers (optional, for CI push)
GITHUB_REPO_URL=https://github.com/your-username/algo-trader.git
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_USERNAME=your-username
GITHUB_REMOTE_NAME=origin
GIT_REPO_PATH=.
GITHUB_BRANCH=dev
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Test commands (can be left empty to skip)
UNIT_TEST_COMMAND=pytest
INTEGRATION_TEST_COMMAND=

BACKTESTING_DATABASE_URL=postgresql+psycopg://backtest_user:backtest_pass@localhost:5440/backtesting_db
SIMULATION_COMMISSION=0
SIMULATION_SLIPPAGE=0


