# Core runtime
MODE=paper
LOG_LEVEL=INFO

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=algo
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5433/algo

# Redis
REDIS_URL=redis://localhost:6379/0

# Market data sources
# Options: ibkr, alphavantage, yfinance
MARKET_DATA_SOURCE=alphavantage
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Broker configuration
BROKER_SIMULATED=true
SIMULATED_EQUITY=100000
IBKR_HOST=127.0.0.1
IBKR_PORT=7497          # 7497 = paper, 7496 = live
IBKR_CLIENT_ID=101

# GitHub deployment helpers
GITHUB_REPO_URL=https://github.com/digitalab-creator/algo-trader.git
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO_URL=https://digitalab-creator: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@github.com/digitalab-creator/algo-trader.git
GITHUB_USERNAME=digitalab-creator
GITHUB_REMOTE_NAME=origin
GIT_REPO_PATH=.
GITHUB_BRANCH=dev
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Test commands (can be left empty to skip)
UNIT_TEST_COMMAND=pytest
INTEGRATION_TEST_COMMAND=


